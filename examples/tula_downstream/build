#!/usr/bin/env bash
set -euo pipefail

source_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if [[ -n "${TULA_CMAKE_DEV_PROJECT:-}" ]]; then
    base_profile="$(
        uv run --project "${TULA_CMAKE_DEV_PROJECT}" \
            tula-cmake profile linux-gcc13-debug
    )"
    exec uv run --project "${TULA_CMAKE_DEV_PROJECT}" \
        tula-cmake build "${source_dir}" \
        --profile "${base_profile}" \
        "$@"
fi

exec uvx --from "tula-cmake==3.1.0" \
    tula-cmake build "${source_dir}" "$@"
